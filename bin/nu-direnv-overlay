#!/usr/bin/env bash
set -euo pipefail

# Small helper CLI for installations that need literal source lines.
# It does not perform hook installation itself; it only prints paths/snippets so
# users or Nix modules can place them in the right config file.

case "${1:-help}" in
  hook)
    case "${2:-}" in
      nu|nushell)
        # Print a literal Nushell source line. Nushell parser keywords require a
        # literal path, so callers should paste/evaluate this exact output.
        pkg=${NU_DIRENV_OVERLAY_PKG:-$(cd "$(dirname "$0")/.." && pwd -P)}
        printf 'source %q\n' "$pkg/share/nushell/vendor/autoload/nu-direnv-overlay.nu"
        ;;
      direnv)
        # Print a literal Bash source line for direnvrc. direnv evaluates .envrc
        # in Bash, so the direnv-side helper is a shell script.
        pkg=${NU_DIRENV_OVERLAY_PKG:-$(cd "$(dirname "$0")/.." && pwd -P)}
        printf 'source %q\n' "$pkg/share/direnv/lib/nu-overlay.sh"
        ;;
      *)
        printf 'usage: nu-direnv-overlay hook nu|direnv\n' >&2
        exit 2
        ;;
    esac
    ;;
  paths)
    # Useful when vendor autoload or direnv share directory discovery is not
    # available and the user needs to wire files manually.
    pkg=${NU_DIRENV_OVERLAY_PKG:-$(cd "$(dirname "$0")/.." && pwd -P)}
    printf '%s\n' "$pkg/share/direnv/lib/nu-overlay.sh"
    printf '%s\n' "$pkg/share/nushell/vendor/autoload/nu-direnv-overlay.nu"
    ;;
  hook-direnv)
    # Backwards-compatible alias kept for early README examples.
    pkg=${NU_DIRENV_OVERLAY_PKG:-$(cd "$(dirname "$0")/.." && pwd -P)}
    printf 'source %q\n' "$pkg/share/direnv/lib/nu-overlay.sh"
    ;;
  help|--help|-h)
    cat <<'EOF'
nu-direnv-overlay

Installed files:
  nu-direnv-overlay paths

Print shell hooks:
  nu-direnv-overlay hook nu
  nu-direnv-overlay hook direnv

For direnv configs that do not load package share directories automatically:
  eval "$(nu-direnv-overlay hook direnv)"
EOF
    ;;
  *)
    printf 'unknown command: %s\n' "$1" >&2
    exit 2
    ;;
esac
